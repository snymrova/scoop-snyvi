    "url": "https://github.com/snymrova/snyvi/releases/download/v1.10.0/snyvi-1.10.0-x86_64-pc-windows-msvc.zip",
    "hash": "fc042be9367dd803923f4371bc5a6ea1ee5124a0938abf087b56fcc29b1db065",
    "extract_dir": "snyvi-1.10.0-x86_64-pc-windows-msvc",
    "bin": "snyvi.exe",
    "pre_uninstall": [
        "if (Test-Path \"$dir\\snyvi.exe\") { & \"$dir\\snyvi.exe\" stop 2>$null }",
        "Stop-Process -Name snyvi-app, snyvi -Force -ErrorAction SilentlyContinue"
    ],
    "notes": [
        "snyvi init-claude --auto   connects Claude Code; snyvi init <agent> for the others",
        "snyvi app                  opens the window; snyvi send FILE.md prints a link"
    ],
    "checkver": {
        "github": "https://github.com/snymrova/snyvi"
    },
    "autoupdate": {
        "url": "https://github.com/snymrova/snyvi/releases/download/v$version/snyvi-$version-x86_64-pc-windows-msvc.zip",
        "extract_dir": "snyvi-$version-x86_64-pc-windows-msvc",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
